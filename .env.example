# ---------------------------------------------------------------------------
# Booking (Cal.com)
# ---------------------------------------------------------------------------
# Your Cal.com link, WITHOUT the https://cal.com/ prefix.
# Example: praxes/discovery  ->  https://cal.com/praxes/discovery
NEXT_PUBLIC_CAL_LINK=praxes/discovery

# Booking provider. "cal" (default) or "calendly".
# Swapping to Calendly: set this to "calendly" and put your full Calendly URL
# in NEXT_PUBLIC_CALENDLY_URL. See lib/booking.ts.
NEXT_PUBLIC_BOOKING_PROVIDER=cal
NEXT_PUBLIC_CALENDLY_URL=

# ---------------------------------------------------------------------------
# Contact form (Resend) — optional
# ---------------------------------------------------------------------------
# If RESEND_API_KEY is unset, the contact route logs the submission and returns
# success, so local dev and preview builds work without any keys.
RESEND_API_KEY=
CONTACT_TO_EMAIL=praxesconsulting.hr@gmail.com
# Must be a domain verified in Resend. Falls back to Resend's sandbox sender.
CONTACT_FROM_EMAIL=Praxes Website <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://praxes.consulting

# Optional analytics slot (e.g. a Plausible/Umami/GA id). Vercel Analytics is
# already wired in app/layout.tsx and needs no key.
NEXT_PUBLIC_ANALYTICS=
